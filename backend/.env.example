# proveedor principal. API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# low/medium/high: esfuerzo de razonamiento del modelo
OPENROUTER_REASONING_EFFORT=high
# fallback 1 si OpenRouter falla. API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# low/high/max: low reduce el "thinking" interno (más rápido, menos razonamiento profundo)
DEEPSEEK_REASONING_EFFORT=low
# fallback 2 si OpenRouter y DeepSeek fallan. API key gratis: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
ALLOWED_ORIGIN=*
PORT=3000
CHUNK_CHARS=40000
MAX_CHUNKS=40
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
# schema donde viven las tablas (ver migrations/004_move_to_schema.sql)
DB_SCHEMA=wa_nalizer
